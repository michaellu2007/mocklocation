<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 高德/百度 SDK 拉取瓦片与鉴权必须;新版 3dmap AAR 不再自动合入此权限,漏了就是永远灰网格 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 定位:API 31+ 必须 FINE 与 COARSE 成对声明,缺 COARSE 会被降级/拒绝 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 前台服务:API 34+ 起除 FOREGROUND_SERVICE 外还必须声明 FOREGROUND_SERVICE_LOCATION,
         且 <service> 上要写 android:foregroundServiceType="location" -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- API 33+ 前台服务常驻通知需要运行时申请 POST_NOTIFICATIONS -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 后台定位:API 30+ 必须运行时单独申请,不能和其他权限打包请求 -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!--
      ACCESS_MOCK_LOCATION 是 signature 级权限,仅声明不会生效。
      真正生效方式(二选一):
        1. 开发者选项 → 选择模拟位置信息应用 → 选中本应用
        2. adb shell appops set com.learning.mockrun android:mock_location allow
    -->
    <uses-permission android:name="android.permission.ACCESS_MOCK_LOCATION" />

    <application
        android:name=".MockRunApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MockRun">

        <!-- 高德 key 来自 local.properties 的 amap_key(gitignore 内);留空时地图空白但不崩 -->
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${amapKey}" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AMapPickerActivity"
            android:exported="false" />

        <activity
            android:name=".RouteEditorActivity"
            android:exported="false" />

        <activity
            android:name=".SavedRoutesActivity"
            android:exported="false" />

        <service
            android:name=".MockLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- 路线文件分享(收集用户上传的路线用) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
