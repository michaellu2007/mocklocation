<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/donate_wechat_label"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/qr_wechat"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="6dp"
            android:contentDescription="@string/donate_wechat_label"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/donate_alipay_label"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/qr_alipay"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="6dp"
            android:contentDescription="@string/donate_alipay_label"
            android:scaleType="fitCenter" />
    </LinearLayout>
</ScrollView>
